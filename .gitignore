.vscode
.idea
.Ds_Store
node_modules
go.mod
go.sum
# 书稿配套的可运行示例是独立模块，要能提交
!tools/examples/**/go.mod
!tools/examples/**/go.sum
.temp
.cache
dist
# 鲁班写作法索引产物（make-index.py 生成，可随时重建）
_luban/

# Python 缓存（脚本产物）
__pycache__/
*.pyc

# linkify-refs.py 的备份（不是书稿正文）
.linkify-bak/

# 示例区的编译产物（go build ./... 会输出到 code/ 根目录）
tools/examples/**/code/*
!tools/examples/**/code/*.go
!tools/examples/**/code/*.mod
!tools/examples/**/code/*.sum
!tools/examples/**/code/*.sh
!tools/examples/**/code/*.py
!tools/examples/**/code/*.sql
!tools/examples/**/code/*.lua
!tools/examples/**/code/*.md
!tools/examples/**/code/*.txt
!tools/examples/**/code/*.json
!tools/examples/**/code/*/
