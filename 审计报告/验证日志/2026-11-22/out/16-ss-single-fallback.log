--- 回退后 database-sharding.yaml（关键段） ---
databaseName: sharding_db
dataSources:
  ds_0:
    url: jdbc:mysql://host.docker.internal:13306/ss_order?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: root
    password: luban123
    connectionTimeoutMilliseconds: 30000
    idleTimeoutMilliseconds: 60000
    maxLifetimeMilliseconds: 1800000
    maxPoolSize: 10
    minPoolSize: 1
rules:
  - !SINGLE
    tables:
      - ds_0.t_order
    defaultDataSource: ds_0

